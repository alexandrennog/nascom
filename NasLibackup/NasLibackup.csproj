<?xml version="1.0" encoding="utf-8"?>
<!--
  NasLibackup - backup do banco do Nascomercio (local + nuvem AWS S3).
  Biblioteca chamada pelo nascomercio.exe (mdiPrincipal / tela de Backup).
  Mesmo estilo do LibNF65: .NET Framework 4.7.2, x86, pacotes na pasta
  ..\packages (packages.config). Toda a configuracao fica no app.config do
  nascomercio (chaves "Backup..."), nao existe appsettings.json aqui.
-->
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <!-- Mesmo GUID que o nascomercio.vbproj ja usava na referencia ao NasLibackup -->
    <ProjectGuid>{408F1CDF-EBBF-4A05-86DE-AD4A92B8BF20}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>NasLibackup</RootNamespace>
    <AssemblyName>NasLibackup</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <LangVersion>7.3</LangVersion>
    <OutputPath>bin\Debug\</OutputPath>
  </PropertyGroup>
  <!-- x86 em Debug e Release, igual ao nascomercio.vbproj e ao LibNF65 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PlatformTarget>x86</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <OutputPath>bin\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PlatformTarget>x86</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <OutputPath>bin\Release\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AWSSDK.Core, Version=3.3.0.0, Culture=neutral, PublicKeyToken=885c28607f98e604, processorArchitecture=MSIL">
      <HintPath>..\packages\AWSSDK.Core.3.7.500.61\lib\net45\AWSSDK.Core.dll</HintPath>
    </Reference>
    <Reference Include="AWSSDK.S3, Version=3.3.0.0, Culture=neutral, PublicKeyToken=885c28607f98e604, processorArchitecture=MSIL">
      <HintPath>..\packages\AWSSDK.S3.3.7.509.2\lib\net45\AWSSDK.S3.dll</HintPath>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="ConfiguracaoBackup.cs" />
    <Compile Include="DumpMySql.cs" />
    <Compile Include="EmailDeFalha.cs" />
    <Compile Include="Libackup.cs" />
    <Compile Include="LogBackup.cs" />
    <Compile Include="ResultadoBackup.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="packages.config" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
