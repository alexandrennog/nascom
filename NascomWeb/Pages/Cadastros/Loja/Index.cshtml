@page
@model NascomWeb.Pages.Cadastros.Loja.IndexModel
@{
    ViewData["Title"] = "Lojas";
}

<h1>Lojas</h1>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label">Nome Fantasia</label>
        <input asp-for="NomeFantasia" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label">Situação</label>
        <select asp-for="Situacao" class="form-select">
            <option value="">Todas</option>
            <option value="A">Ativa</option>
            <option value="I">Inativa</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Pesquisar</button>
    </div>
    <div class="col-auto ms-auto">
        <a asp-page="Edit" class="btn btn-primary">Nova Loja</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Código</th>
            <th>Nome Fantasia</th>
            <th>CNPJ</th>
            <th>Situação</th>
            <th class="text-end">Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Resultados)
        {
            <tr>
                <td>@item.codigo</td>
                <td>@item.nomeFantasia</td>
                <td>@item.cnpj</td>
                <td>@(item.situacao == "A" ? "Ativa" : "Inativa")</td>
                <td class="text-end">
                    <a asp-page="Edit" asp-route-id="@item.cid" class="btn btn-sm btn-outline-secondary">Editar</a>
                    <form method="post" asp-page-handler="Excluir" asp-route-cid="@item.cid"
                          data-confirm="Confirma a exclusão da loja '@item.nomeFantasia'?" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Resultados.Count == 0)
        {
            <tr>
                <td colspan="5" class="text-center text-muted">Nenhum registro encontrado.</td>
            </tr>
        }
    </tbody>
</table>
