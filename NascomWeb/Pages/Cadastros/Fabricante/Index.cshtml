@page
@model NascomWeb.Pages.Cadastros.Fabricante.IndexModel
@{
    ViewData["Title"] = "Fabricantes";
}

<h1>Fabricantes</h1>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label">Nome</label>
        <input asp-for="Nome" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label">Situação</label>
        <select asp-for="Situacao" class="form-select">
            <option value="">Todas</option>
            <option value="A">Ativo</option>
            <option value="I">Inativo</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Pesquisar</button>
    </div>
    <div class="col-auto ms-auto">
        <a asp-page="Edit" class="btn btn-primary">Novo Fabricante</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Situação</th>
            <th class="text-end">Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Resultados)
        {
            <tr>
                <td>@item.nome</td>
                <td>@(item.situacao == "A" ? "Ativo" : "Inativo")</td>
                <td class="text-end">
                    <a asp-page="Edit" asp-route-id="@item.cid" class="btn btn-sm btn-outline-secondary">Editar</a>
                    <form method="post" asp-page-handler="Excluir" asp-route-cid="@item.cid"
                          data-confirm="Confirma a exclusão do fabricante '@item.nome'?" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Resultados.Count == 0)
        {
            <tr>
                <td colspan="3" class="text-center text-muted">Nenhum registro encontrado.</td>
            </tr>
        }
    </tbody>
</table>
