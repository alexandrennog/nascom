@page "{id:int?}"
@model NascomWeb.Pages.Cadastros.Produto.EditModel
@{
    ViewData["Title"] = Model.ProdutoJaSalvo ? "Editar Produto" : "Novo Produto";
    var colunasGrade = Model.Linhas.SelectMany(l => l.Valores.Keys).Distinct().OrderBy(c => c).ToList();
    var caracteristicasEditaveis = Model.CaracteristicasDoTipo.Where(c => c.caracteristica_codigo is not ("estoque" or "codigobarras")).ToList();
}

<h1>@ViewData["Title"]</h1>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <button class="nav-link @(Model.Tab == "dados" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tab-dados" type="button">Dados do Produto</button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(Model.Tab == "grade" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tab-grade" type="button" @(Model.ProdutoJaSalvo ? "" : "disabled")>Grade</button>
    </li>
</ul>

@if (!Model.ProdutoJaSalvo)
{
    <div class="alert alert-info">Salve os Dados do Produto para liberar a Grade de variações.</div>
}

<div class="tab-content">
    <div class="tab-pane fade @(Model.Tab == "dados" ? "show active" : "")" id="tab-dados">
        <form method="post" asp-page-handler="Dados" asp-route-id="@Model.Dados.cid" class="row g-3" data-confirm="Confirma a gravação das informações?">
            <input type="hidden" asp-for="Dados.cid" />

            <div class="col-md-2">
                <label asp-for="Dados.codigo" class="form-label">Código</label>
                <input asp-for="Dados.codigo" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Dados.descricao" class="form-label">Descrição</label>
                <input asp-for="Dados.descricao" class="form-control" autofocus />
                <span asp-validation-for="Dados.descricao" class="text-danger"></span>
            </div>
            <div class="col-md-2">
                <label asp-for="Dados.referencia" class="form-label">Referência</label>
                <input asp-for="Dados.referencia" class="form-control" />
            </div>
            <div class="col-md-2">
                <label asp-for="Dados.situacao" class="form-label">Situação</label>
                <select asp-for="Dados.situacao" class="form-select">
                    <option value="A">Ativo</option>
                    <option value="I">Inativo</option>
                </select>
            </div>

            <div class="col-md-3">
                <label asp-for="Dados.produtoTipo_cid" class="form-label">Tipo de Produto</label>
                <select asp-for="Dados.produtoTipo_cid" class="form-select">
                    <option value="">Selecione</option>
                    @foreach (var t in Model.ProdutoTipos)
                    {
                        <option value="@t.cid">@t.nome</option>
                    }
                </select>
                <span asp-validation-for="Dados.produtoTipo_cid" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Dados.fornecedor_cid" class="form-label">Fornecedor</label>
                <select asp-for="Dados.fornecedor_cid" class="form-select">
                    <option value="">Selecione</option>
                    @foreach (var f in Model.Fornecedores)
                    {
                        <option value="@f.cid">@f.nome</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="Dados.fabricante_cid" class="form-label">Fabricante</label>
                <select asp-for="Dados.fabricante_cid" class="form-select">
                    <option value="">Selecione</option>
                    @foreach (var f in Model.Fabricantes)
                    {
                        <option value="@f.cid">@f.nome</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="Dados.grupo_cid" class="form-label">Grupo</label>
                <select asp-for="Dados.grupo_cid" class="form-select">
                    <option value="">Selecione</option>
                    @foreach (var g in Model.Grupos)
                    {
                        <option value="@g.cid">@g.nome</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label asp-for="Dados.cor_cid" class="form-label">Cor</label>
                <select asp-for="Dados.cor_cid" class="form-select">
                    <option value="">Selecione</option>
                    @foreach (var c in Model.Cores)
                    {
                        <option value="@c.cid">@c.nome</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="Dados.valorCompra" class="form-label">Valor de Compra</label>
                <input asp-for="Dados.valorCompra" type="number" step="0.01" min="0" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="Dados.valorVenda" class="form-label">Valor de Venda</label>
                <input asp-for="Dados.valorVenda" type="number" step="0.01" min="0" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="Dados.estoqueMinimo" class="form-label">Estoque Mínimo</label>
                <input asp-for="Dados.estoqueMinimo" type="number" min="0" class="form-control" />
            </div>

            <div class="col-md-4">
                <label asp-for="Dados.codigoBarras" class="form-label">Código de Barras (produto simples)</label>
                <input asp-for="Dados.codigoBarras" class="form-control" />
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-primary">Salvar</button>
                <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>

    <div class="tab-pane fade @(Model.Tab == "grade" ? "show active" : "")" id="tab-grade">
        @if (Model.ProdutoJaSalvo)
        {
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        @foreach (var col in colunasGrade)
                        {
                            <th>@col</th>
                        }
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var linha in Model.Linhas)
                    {
                        <tr>
                            @foreach (var col in colunasGrade)
                            {
                                <td>@(linha.Valores.TryGetValue(col, out var v) ? v : "")</td>
                            }
                            <td class="text-end">
                                <form method="post" asp-page-handler="RemoverLinha" asp-route-id="@Model.Dados.cid" asp-route-item="@linha.Item"
                                      data-confirm="Confirma a remoção desta variação da grade?" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Remover</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (Model.Linhas.Count == 0)
                    {
                        <tr>
                            <td colspan="@(colunasGrade.Count + 1)" class="text-center text-muted">Nenhuma variação cadastrada.</td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (Model.CaracteristicasDoTipo.Count == 0)
            {
                <div class="alert alert-warning">
                    O Tipo de Produto selecionado não tem características vinculadas.
                    Cadastre-as em <a asp-page="/Cadastros/ProdutoTipo/Edit" asp-route-id="@Model.Dados.produtoTipo_cid">Tipo de Produto</a> antes de adicionar variações.
                </div>
            }
            else
            {
                <h2 class="h5 mt-4">Adicionar variação</h2>
                <form method="post" asp-page-handler="AdicionarLinha" asp-route-id="@Model.Dados.cid" class="row g-3">
                    @foreach (var c in caracteristicasEditaveis)
                    {
                        <div class="col-md-2">
                            <label class="form-label">@c.caracteristica_nome</label>
                            @if (Model.ItensPorCaracteristica.TryGetValue(c.caracteristica_codigo ?? string.Empty, out var itensPossiveis))
                            {
                                <select name="NovaLinhaValores[@c.caracteristica_codigo]" class="form-select">
                                    <option value="">Selecione</option>
                                    @foreach (var iv in itensPossiveis)
                                    {
                                        <option value="@iv.valor">@iv.valor</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <input name="NovaLinhaValores[@c.caracteristica_codigo]" class="form-control" />
                            }
                        </div>
                    }
                    <div class="col-md-2">
                        <label asp-for="NovaLinhaCodigoBarras" class="form-label">Código de Barras</label>
                        <input asp-for="NovaLinhaCodigoBarras" class="form-control" placeholder="Deixe em branco para gerar" />
                    </div>
                    <div class="col-md-2">
                        <label asp-for="NovaLinhaEstoque" class="form-label">Estoque Inicial</label>
                        <input asp-for="NovaLinhaEstoque" type="number" step="1" min="0" class="form-control" />
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">Adicionar</button>
                    </div>
                </form>
            }
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
