@page
@model NascomWeb.Pages.Cadastros.Produto.IndexModel
@{
    ViewData["Title"] = "Produtos";
}

<h1>Produtos</h1>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label">Descrição</label>
        <input asp-for="Descricao" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label">Situação</label>
        <select asp-for="Situacao" class="form-select">
            <option value="">Todas</option>
            <option value="A">Ativo</option>
            <option value="I">Inativo</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Pesquisar</button>
    </div>
    <div class="col-auto ms-auto">
        <a asp-page="Edit" class="btn btn-primary">Novo Produto</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Código</th>
            <th>Descrição</th>
            <th>Cor</th>
            <th>Grupo</th>
            <th>Valor Venda</th>
            <th>Situação</th>
            <th class="text-end">Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Resultados)
        {
            <tr>
                <td>@item.codigo</td>
                <td>@item.descricao</td>
                <td>@item.cor</td>
                <td>@item.grupo</td>
                <td>@item.valorVenda?.ToString("C2")</td>
                <td>@(item.situacao == "A" ? "Ativo" : "Inativo")</td>
                <td class="text-end">
                    <a asp-page="Edit" asp-route-id="@item.cid" class="btn btn-sm btn-outline-secondary">Editar</a>
                    <form method="post" asp-page-handler="Excluir" asp-route-cid="@item.cid"
                          data-confirm="Confirma a exclusão do produto '@item.descricao'?" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Resultados.Count == 0)
        {
            <tr>
                <td colspan="7" class="text-center text-muted">Nenhum registro encontrado.</td>
            </tr>
        }
    </tbody>
</table>
