@page "{id:int?}"
@model NascomWeb.Pages.Cadastros.Municipios.EditModel
@{
    ViewData["Title"] = Model.Dados.cid is null or 0 ? "Novo Município" : "Editar Município";
}

<h1>@ViewData["Title"]</h1>

<form method="post" class="row g-3" data-confirm="Confirma a gravação das informações?" style="max-width: 480px;">
    <input type="hidden" asp-for="Dados.cid" />

    <div class="col-12">
        <label asp-for="Dados.nome" class="form-label">Nome</label>
        <input asp-for="Dados.nome" class="form-control" autofocus />
        <span asp-validation-for="Dados.nome" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Dados.codigo_ibge" class="form-label">Código IBGE</label>
        <input asp-for="Dados.codigo_ibge" class="form-control" />
    </div>

    <div class="col-12">
        <label asp-for="Dados.estados_cid" class="form-label">Estado</label>
        <select asp-for="Dados.estados_cid" class="form-select">
            <option value="">Selecione</option>
            @foreach (var e in Model.Estados)
            {
                <option value="@e.cid">@e.sigla - @e.nome</option>
            }
        </select>
        <span asp-validation-for="Dados.estados_cid" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Dados.situacao" class="form-label">Situação</label>
        <select asp-for="Dados.situacao" class="form-select">
            <option value="A">Ativo</option>
            <option value="I">Inativo</option>
        </select>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
