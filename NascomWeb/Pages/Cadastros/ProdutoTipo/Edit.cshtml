@page "{id:int?}"
@model NascomWeb.Pages.Cadastros.ProdutoTipo.EditModel
@{
    ViewData["Title"] = Model.TipoJaSalvo ? "Editar Tipo de Produto" : "Novo Tipo de Produto";
    var vinculadosCid = Model.Caracteristicas.Select(c => c.caracteristica_cid).ToHashSet();
}

<h1>@ViewData["Title"]</h1>

<form method="post" class="row g-3 mb-4" data-confirm="Confirma a gravação das informações?" style="max-width: 480px;">
    <input type="hidden" asp-for="Dados.cid" />

    <div class="col-12">
        <label asp-for="Dados.nome" class="form-label">Nome</label>
        <input asp-for="Dados.nome" class="form-control" autofocus />
        <span asp-validation-for="Dados.nome" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Dados.situacao" class="form-label">Situação</label>
        <select asp-for="Dados.situacao" class="form-select">
            <option value="A">Ativo</option>
            <option value="I">Inativo</option>
        </select>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@if (Model.TipoJaSalvo)
{
    <hr />
    <h2 class="h4">Características vinculadas</h2>

    <table class="table table-sm table-striped" style="max-width: 640px;">
        <thead>
            <tr>
                <th>Código</th>
                <th>Nome</th>
                <th>Qtde. de itens</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Caracteristicas)
            {
                <tr>
                    <td>@c.caracteristica_codigo</td>
                    <td>@c.caracteristica_nome</td>
                    <td>@c.quantidade</td>
                    <td class="text-end">
                        <form method="post" asp-page-handler="RemoverCaracteristica" asp-route-id="@Model.Dados.cid" asp-route-vinculoCid="@c.cid"
                              data-confirm="Confirma a remoção do vínculo com '@c.caracteristica_nome'?" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Remover</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Caracteristicas.Count == 0)
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">Nenhuma característica vinculada.</td>
                </tr>
            }
        </tbody>
    </table>

    <form method="post" asp-page-handler="AdicionarCaracteristica" asp-route-id="@Model.Dados.cid" class="row g-3" style="max-width: 640px;">
        <div class="col-8">
            <select asp-for="CaracteristicaSelecionada" class="form-select">
                <option value="">Selecione uma característica</option>
                @foreach (var c in Model.TodasCaracteristicas.Where(c => !vinculadosCid.Contains(c.cid)))
                {
                    <option value="@c.cid">@c.nome</option>
                }
            </select>
        </div>
        <div class="col-4">
            <button type="submit" class="btn btn-primary w-100">Vincular</button>
        </div>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
