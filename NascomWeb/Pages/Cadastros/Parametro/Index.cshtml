@page
@model NascomWeb.Pages.Cadastros.Parametro.IndexModel
@{
    ViewData["Title"] = "Parâmetros";
}

<h1>Parâmetros</h1>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label">Descrição</label>
        <input asp-for="Descricao" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Pesquisar</button>
    </div>
    <div class="col-auto ms-auto">
        <a asp-page="Edit" class="btn btn-primary">Novo Parâmetro</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Descrição</th>
            <th>Valor</th>
            <th class="text-end">Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Resultados)
        {
            <tr>
                <td>@item.descricao</td>
                <td>@item.valor</td>
                <td class="text-end">
                    <a asp-page="Edit" asp-route-id="@item.cid" class="btn btn-sm btn-outline-secondary">Editar</a>
                    <form method="post" asp-page-handler="Excluir" asp-route-cid="@item.cid"
                          data-confirm="Confirma a exclusão do parâmetro '@item.descricao'?" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Resultados.Count == 0)
        {
            <tr>
                <td colspan="3" class="text-center text-muted">Nenhum registro encontrado.</td>
            </tr>
        }
    </tbody>
</table>
