@page "{id:int?}"
@model NascomWeb.Pages.Cadastros.Parametro.EditModel
@{
    ViewData["Title"] = Model.Dados.cid is null or 0 ? "Novo Parâmetro" : "Editar Parâmetro";
}

<h1>@ViewData["Title"]</h1>

<form method="post" class="row g-3" data-confirm="Confirma a gravação das informações?" style="max-width: 480px;">
    <input type="hidden" asp-for="Dados.cid" />

    <div class="col-12">
        <label asp-for="Dados.descricao" class="form-label">Descrição</label>
        <input asp-for="Dados.descricao" class="form-control" autofocus />
        <span asp-validation-for="Dados.descricao" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Dados.valor" class="form-label">Valor</label>
        <input asp-for="Dados.valor" class="form-control" />
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
