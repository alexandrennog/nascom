<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NascomWeb</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NascomWeb.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Nascomercio</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/Cadastros/Cliente/Index">Clientes</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/Cadastros/Fornecedor/Index">Fornecedores</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/Cadastros/Produto/Index">Produtos</a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown">Cadastros Gerais</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-page="/Cadastros/Cor/Index">Cor</a></li>
                                    <li><a class="dropdown-item" asp-page="/Cadastros/Categoria/Index">Categoria</a></li>
                                    <li><a class="dropdown-item" asp-page="/Cadastros/Grupo/Index">Grupo</a></li>
                                    <li><a class="dropdown-item" asp-page="/Cadastros/Fabricante/Index">Fabricante</a></li>
                                    <li><a class="dropdown-item" asp-page="/Cadastros/Estado/Index">Estado</a></li>
                                    <li><a class="dropdown-item" asp-page="/Cadastros/Condicao/Index">Condição</a></li>
                                    <li><a class="dropdown-item" asp-page="/Cadastros/Servico/Index">Serviço</a></li>
                                    <li><a class="dropdown-item" asp-page="/Cadastros/ProdutoTipo/Index">Tipo de Produto</a></li>
                                    <li><a class="dropdown-item" asp-page="/Cadastros/Caracteristica/Index">Característica</a></li>
                                    <li><a class="dropdown-item" asp-page="/Cadastros/Municipios/Index">Município</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown">Administração</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-page="/Cadastros/Usuario/Index">Usuário</a></li>
                                    <li><a class="dropdown-item" asp-page="/Cadastros/UsuarioPerfil/Index">Perfil de Usuário</a></li>
                                    <li><a class="dropdown-item" asp-page="/Cadastros/Loja/Index">Loja</a></li>
                                    <li><a class="dropdown-item" asp-page="/Cadastros/Parametro/Index">Parâmetro</a></li>
                                </ul>
                            </li>
                        </ul>
                        <ul class="navbar-nav">
                            <li class="nav-item d-flex align-items-center me-3 text-muted">
                                <span>@User.Identity!.Name (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)</span>
                            </li>
                            <li class="nav-item">
                                <form method="post" asp-page="/Logout">
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Sair</button>
                                </form>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/Login">Entrar</a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Mensagem"] is string mensagem)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @mensagem
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmação</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="confirmModalMessage"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="confirmModalOk">Confirmar</button>
                </div>
            </div>
        </div>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - NascomWeb - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
