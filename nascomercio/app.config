<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
  </configSections>
  <connectionStrings>
    <add name="nascomercio" connectionString="Data Source=127.0.1.1;Database=nascomercio;User ID=root;Password=PLjNJNJzXGtfrP7TqBRTsazpWOOZmDsHsuUinT0EGHg=;Allow User Variables=True;Allow Zero Datetime=True;Convert Zero Datetime=True;persist security info=True" />
    <add name="nascomercio.My.MySettings.ConnectionString" connectionString="Dsn=nascomercio_ODBC" providerName="System.Data.Odbc" />
    <add name="nascomercio.My.MySettings.nascomercioConnectionString" connectionString="server=127.0.1.1; port=3306; database=nascomercio; user id=root; password=15mysql; Allow User Variables=True;Allow Zero Datetime=True;Convert Zero Datetime=True;pooling=false" providerName="MySql.Data.MySqlClient" />
  </connectionStrings>
  <!-- As chaves secretas (AWS) ficam no arquivo backup.segredos.config, ao lado
       do nascomercio.exe. Ele NAO vai para o Git (esta no .gitignore). Se nao existir,
       o sistema funciona normal, so o envio para a nuvem falha.
       Modelo: nascomercio\backup.segredos.exemplo.config -->
  <appSettings file="backup.segredos.config">
    <!-- Sem essa chave (ou com valor diferente de SIM), o sistema é tratado como VERSÃO DE
         TESTE: mostra uma faixa vermelha "VERSÃO DE TESTE" na tela principal, pra não
         confundir com o sistema oficial em uso pelo cliente. Adicionar VERSAO_OFICIAL=SIM
         só no app.config da instalação que for a versão oficial lançada pro cliente. -->
    <!-- <add key="VERSAO_OFICIAL" value="SIM" /> -->
    <add key="FISCAL" value="ONLINE" />
    <add key="LABEL_DEBITO" value="Cartão" />
    <add key="LABEL_CREDITO" value="Cartão" />
    <add key="CUPOM" value="LAZ" /> 
    <add key="SEGUNDA_VIA" value="NAO"/>
    <add key="CORTAR_PAPEL" value="NAO"/>
    <add key="ORDEM_SERVIÇO" value="NAO"/>
    <add key="ETIQUETA" value="USB2"/>
    <add key="TIPO_TERMINAL" value="CAIXA" /> 
    <add key="NOME_TERMINAL" value="CAIXA 01" />
    <add key="DIRETORIO_FOTO" value="c:\nascomercio\fotos" />
    <add key="BD_USUARIO" value="root" />
    <add key="BD_SENHA" value="PLjNJNJzXGtfrP7TqBRTsazpWOOZmDsHsuUinT0EGHg=" />
    <add key="BD_NOMEBANCO" value="nascomercio" />
    <add key="BD_APLICATIVO" value="C:\Arquivos de programas\MySQL\MySQL Server 5.1\bin\" />
    <add key="nascomercioMail" value="nascomerciomail@gmail.com" />
    <add key="nascomercioPass" value="svmnjitporjcqgqp" />
    <add key="perfilGestor" value="ADMINISTRADOR" />
    <add key="exibirRelsExcecao" value="SIM" />
    <add key="pathPIX" value="C:\nascomercio\PIX" />
    <add key="Banco" value="MercadoPago" />
    <add key="pathRelatorio" value="C:\nascomercio\" />
    <add key="CertificadoArquivo" value="" />
    <add key="CertificadoSenha" value="" />
    <add key="TipoAmbiente" value="2" />
    <add key="UsaCertificadoDigital" value="1" />
    <add key="CSC" value="6aacb219-28ae-4131-b7c1-21b5d8e40337" />
    <add key="CSCIDToken" value="1" />
    <add key="SchemaVersao" value="4.00" />
    <add key="VersaoConfiguracao" value="4.00" />
    <add key="CNPJ" value="36650283000164" />
    <!-- Código do município (IBGE) da loja, usado na emissão da NFC-e quando a SEFAZ
         não devolve esse código junto com o cadastro do emitente. Ex.: São Paulo
         capital = 3550308. Preencher com o código da cidade de CADA loja. -->
    <add key="CodigoMunicipio" value="3548708" />
    <!-- UF (sigla do estado, ex.: SP, RJ, MG) da loja, usada na consulta de cadastro,
         emissão e cancelamento da NFC-e junto à SEFAZ. Sem essa chave (ou com valor
         inválido) o sistema usa SP como padrão. Ajustar por loja quando não for SP. -->
    <add key="UF" value="SP" />
    <add key="clientID" value="1030" />
    <add key="Cliente" value="CALCIAKI" />
    <add key="Loja" value="matriz" />
    <add key="bucketName" value="nascombackup" />
    <add key="directoryBackupPath" value="C:\\nascomercio\\backup\\" />
    <add key="BACKUPAUTOMATICO" value="SIM" />
    <!-- ==================== BACKUP LOCAL + NUVEM (NasLibackup) ====================
         Usado pelo backup automatico (BACKUPAUTOMATICO = SIM: roda 1 vez por dia, no
         primeiro terminal que abrir o sistema) e pelo botao "Fazer backup agora" da
         tela de Backup. Cada execucao fica no Relatorio de Backups.
         Tambem usa as chaves acima: Cliente, Loja, bucketName e directoryBackupPath
         (pasta onde fica a copia local .zip e a subpasta "logs").
         IMPORTANTE: o backup usa o mysqldump.exe do MySQL, entao deve rodar no
         computador SERVIDOR. Nos terminais de caixa deixe BACKUPAUTOMATICO = NAO. -->
    <!-- Credenciais da AWS: deixe vazias aqui. Os valores de verdade ficam no
         backup.segredos.config (que tem prioridade sobre estas linhas). -->
    <add key="BackupAwsAccessKeyId" value="" />
    <add key="BackupAwsSecretAccessKey" value="" />
    <!-- Regiao do bucket. Pode ficar vazio (usa us-east-1) -->
    <add key="BackupAwsRegiao" value="us-east-1" />
    <!-- Caminho do mysqldump.exe. Pode ficar vazio: usa a pasta do BD_APLICATIVO ou
         procura em C:\Program Files\MySQL\...\bin. Ex.: C:\Program Files\MySQL\MySQL Server 5.5\bin\mysqldump.exe -->
    <add key="BackupMysqldump" value="" />
    <!-- Quantos dias manter os .zip e os logs na pasta local (apagados so depois
         que o backup do dia chegou na nuvem). Podem ficar vazios: 7 e 30 -->
    <add key="BackupDiasRetencaoLocal" value="7" />
    <add key="BackupDiasRetencaoLogs" value="30" />
    <!-- Na NUVEM fica so o ULTIMO backup deste Cliente + Loja: depois que o novo
         arquivo sobe e e conferido, os anteriores dele sao apagados de la (backups de
         outras lojas/clientes nao sao tocados). Por isso Cliente + Loja precisam ser
         unicos por loja. A chave da AWS precisa das permissoes s3:PutObject,
         s3:GetObject, s3:ListBucket e s3:DeleteObject; sem elas o backup continua
         dando certo, so nao apaga os anteriores (aparece "Atencao" no relatorio). -->
    <!-- E-mail de aviso quando o backup falha. Vazio = nao envia.
         Mais de um: separe por virgula. Ex.: suporte@nascom.com.br -->
    <add key="BackupEmailDestinatarios" value="" />
    <!-- Conta que envia o aviso. Podem ficar vazios: usa a conta nascomercioMail /
         nascomercioPass (Gmail) que ja esta acima. Porta 587 (STARTTLS). -->
    <add key="BackupSmtpServidor" value="" />
    <add key="BackupSmtpPorta" value="587" />
    <add key="BackupSmtpUsuario" value="" />
    <add key="BackupSmtpSenha" value="" />
    <add key="BackupEmailRemetente" value="" />
  </appSettings>
  <system.diagnostics>
        <sources>
            <!-- This section defines the logging configuration for My.Application.Log -->
            <source name="DefaultSource" switchName="DefaultSwitch">
                <listeners>
                    <add name="FileLog" />
                    <!-- Uncomment the below section to write to the Application Event Log -->
                    <!--<add name="EventLog"/>-->
                </listeners>
            </source>
        </sources>
        <switches>
            <add name="DefaultSwitch" value="Information" />
        </switches>
        <sharedListeners>
            <add name="FileLog" type="Microsoft.VisualBasic.Logging.FileLogTraceListener, Microsoft.VisualBasic, Version=8.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL" initializeData="FileLogWriter" />
            <!-- Uncomment the below section and replace APPLICATION_NAME with the name of your application to write to the Application Event Log -->
            <!--<add name="EventLog" type="System.Diagnostics.EventLogTraceListener" initializeData="APPLICATION_NAME"/> -->
        </sharedListeners>
    </system.diagnostics>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" /></startup>
