      <Query>
        <DataSourceName>nascomercioConnectionString</DataSourceName>
        <CommandText>
          SELECT     cid, codigo, descricao, produtoTipo_cid, fornecedor_cid, situacao, dataInclusao, valorCompra, valorVenda, imagem, fabricante_cid, referencia,
          produtos_cid, item, caracteristicas_cid, valor, fabricante, fornecedor, IsDecimal
          FROM         v_estoque</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
