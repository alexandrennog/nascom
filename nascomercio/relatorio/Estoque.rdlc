                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=IIF(FIRST(Parameters!IsDecimal.Value) = "1", FormatNumber(Sum(CDec(Fields!valor.Value)), 2), Sum(CDec(Fields!valor.Value)))</Value>
                              <Style>
                                <FontWeight>Bold</FontWeight>
                                <Format>g</Format>
