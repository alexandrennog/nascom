<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
  </configSections>
  <connectionStrings>
    <add name="nascomercio" connectionString="server=localhost; port=3306; database=nascomercio; user id=root; password=; pooling=false" />
    <add name="nascomercio.My.MySettings.ConnectionString" connectionString="Dsn=nascomercio_ODBC" providerName="System.Data.Odbc" />
    <add name="ncsqlce" connectionString="Data Source=D:\informatica\nascomercio\sistema\sqlce\ncsqlce.sdf;Max Database Size=2048;Password=nc#sqlce"
      providerName="System.Data.SqlServerCe.4.0" />
  </connectionStrings>
  <appSettings>
    <add key="FISCAL" value="SAT"/>
    <!--C.Debito-->
    <add key="LABEL_DEBITO" value="Cartão"/>
    <!--C.Credito-->
    <add key="LABEL_CREDITO" value="Cartão"/>
    <add key="CUPOM" value="LAZ"/>
    <add key="CORTAR_PAPEL" value="NAO"/>
    <add key="SEGUNDA_VIA" value="NAO"/>
    <add key="ORDEM_SERVIÇO" value="NAO"/>
    <add key="ETIQUETA" value="COM1"/>
    <add key="TIPO_TERMINAL" value="CAIXA"/>
    <!--ORCAMENTO VENDAS-->
    <add key="NOME_TERMINAL" value="CAIXA 01"/>
    <add key="DIRETORIO_FOTO" value="C:\NASCOMERCIO\NASCOMERCIO\fotos"/>
    <add key="BD_USUARIO" value="root"/>
    <add key="BD_SENHA" value="15mysql"/>
    <add key="BD_NOMEBANCO" value="nascomercio"/>
    <add key="BD_APLICATIVO" value="C:\Program Files\MySQL\MySQL Server 5.6\bin\"/>
  </appSettings>
  <system.diagnostics>
    <sources>
      <!-- This section defines the logging configuration for My.Application.Log -->
      <source name="DefaultSource" switchName="DefaultSwitch">
        <listeners>
          <add name="FileLog"/>
          <!-- Uncomment the below section to write to the Application Event Log -->
          <!--<add name="EventLog"/>-->
        </listeners>
      </source>
    </sources>
    <switches>
      <add name="DefaultSwitch" value="Information" />
    </switches>
    <sharedListeners>
      <add name="FileLog"
           type="Microsoft.VisualBasic.Logging.FileLogTraceListener, Microsoft.VisualBasic, Version=8.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL"
           initializeData="FileLogWriter"/>
      <!-- Uncomment the below section and replace APPLICATION_NAME with the name of your application to write to the Application Event Log -->
      <!--<add name="EventLog" type="System.Diagnostics.EventLogTraceListener" initializeData="APPLICATION_NAME"/> -->
    </sharedListeners>
  </system.diagnostics>
</configuration>
