<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!--add name="nascomercio" connectionString="Data Source=nascom-pc03;Database=nascomercio;User ID=nascomercio;Password=15mysql;" //-->
    <add name="nascomercio" connectionString="Data Source=localhost;Database=nascomercio;User ID=root;Password=15mysql;persist security info=True"/>
    <add name="nascomercio.My.MySettings.nascomercioConnectionString" connectionString="server=localhost;user id=root;persist security info=True;database=nascomercio;password=" providerName="MySql.Data.MySqlClient"/>
  </connectionStrings>
  <appSettings>
    <add key="BD_USUARIO" value="root"/>
    <add key="BD_SENHA" value="15mysql"/>
    <add key="BD_NOMEBANCO" value="nascomercio"/>
    <add key="BD_APLICATIVO" value="C:\Arquivos de programas\MySQL\MySQL Server 5.1\bin\"/>
  </appSettings>
  <system.diagnostics>
        <sources>
            <!-- This section defines the logging configuration for My.Application.Log -->
            <source name="DefaultSource" switchName="DefaultSwitch">
                <listeners>
                    <add name="FileLog"/>
                    <!-- Uncomment the below section to write to the Application Event Log -->
                    <!--<add name="EventLog"/>-->
                </listeners>
            </source>
        </sources>
        <switches>
            <add name="DefaultSwitch" value="Information"/>
        </switches>
        <sharedListeners>
            <add name="FileLog" type="Microsoft.VisualBasic.Logging.FileLogTraceListener, Microsoft.VisualBasic, Version=8.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL" initializeData="FileLogWriter"/>
            <!-- Uncomment the below section and replace APPLICATION_NAME with the name of your application to write to the Application Event Log -->
            <!--<add name="EventLog" type="System.Diagnostics.EventLogTraceListener" initializeData="APPLICATION_NAME"/> -->
        </sharedListeners>
    </system.diagnostics>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8.1"/></startup></configuration>
